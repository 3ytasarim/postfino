# ── Core ──
NODE_ENV=development
DATABASE_URL=postgres://sichttakt:sichttakt@127.0.0.1:54347/sichttakt
APP_URL=http://localhost:3610
API_URL=http://localhost:3611
# Comma separated "version:base64(32 bytes)"; first encrypts. Generate: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
# HMAC secret for signed media URLs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Meta (Instagram API with Facebook Login) — leave empty until the Meta app exists ──
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v27.0
META_CONFIG_ID=

# ── Media: public HTTPS base Meta can fetch from (tunnel / object storage). Required for live publishing ──
MEDIA_PUBLIC_BASE_URL=
MEDIA_STORAGE_DIR=.data/media
MEDIA_URL_TTL_SECONDS=3600

# ── Reels PoC script only ──
META_ACCESS_TOKEN=
META_IG_USER_ID=

# ── Mail: without SMTP_URL mails are written to .data/mail (dev outbox) and NOT delivered ──
# IONOS (port 587, STARTTLS enforced). URL-encode the user (@ -> %40) and special characters in the password.
# SMTP_URL=smtp://info%40postfino.com:PASSWORD@smtp.ionos.com:587?requireTLS=true
SMTP_URL=
MAIL_FROM=Postfino <info@postfino.com>

# ── Storage: local (dev) | s3 (Hetzner Object Storage, e.g. https://fsn1.your-objectstorage.com) ──
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=fsn1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Optional media tooling ──
FFPROBE_PATH=
FFMPEG_PATH=
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── AI assistant (Claude API, paid per token — enable only with approval) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ── Sprint 5 ──
UNSPLASH_ACCESS_KEY=
SHORTLINK_BASE_URL=

# ── Sprint 6: channel developer apps (leave empty → "nicht konfiguriert") ──
# Redirect URI to register everywhere: {API_URL}/oauth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202510
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X API is billed per use — configure only after approving the cost
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com
MASTODON_ENABLED=true
BLUESKY_ENABLED=true

# Flutter web build only (native apps need no CORS), e.g. http://localhost:3620
MOBILE_WEB_ORIGINS=

# ── Billing (Stripe). Live keys = real charges → only after approval. Use sk_test_/whsec_ test keys first. ──
# Webhook endpoint to register in Stripe: {API_URL}/billing/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_AUTOMATIC_TAX=false
STRIPE_TRIAL_DAYS=14
# Enterprise enquiries (billing page mailto); leave empty to hide the link
SALES_CONTACT_EMAIL=

# Show sandbox (MOCK) channels in the UI — development/QA only
SANDBOX_ENABLED=false
