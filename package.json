{
  "name": "sichttakt",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "tsx scripts/dev-db.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:generate": "cd packages/db && drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "dev:web": "next dev apps/web --port 3610",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env apps/worker/src/index.ts",
    "poc:reels": "tsx --env-file-if-exists=.env scripts/reels-cover-poc.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@sichttakt/api": "workspace:*",
    "@sichttakt/config": "workspace:*",
    "@sichttakt/core": "workspace:*",
    "@sichttakt/db": "workspace:*",
    "@sichttakt/shared": "workspace:*",
    "@sichttakt/social-adapters": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-orm": "^0.45.4",
    "embedded-postgres": "18.6.0-beta.19",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
